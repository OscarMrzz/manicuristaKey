---
import Categorias from "./Categorias.astro";
import Hiro from "./Hiro.astro";
import Redes from "./Redes.astro";
import Ubicacion from "./Ubicacion.astro";
import Certificados from "./Certificados.astro";
import Academia from "./Academia.astro";

interface Props {
  showAcademia?: boolean;
  showCertificados?: boolean;
}

const { showAcademia = true, showCertificados = true } = Astro.props;
---

<div id="container">
  <Hiro />
  <Categorias />
  {showCertificados && <Certificados />}
  {showAcademia && <Academia />}
  <Redes />
  <Ubicacion />
</div>