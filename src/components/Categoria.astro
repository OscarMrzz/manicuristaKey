---
const { categoria, descripcion, precio, URLimagen, link } = Astro.props;
---

<a 
  href={link} 
  class="group block bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2"
>
  <div class="relative h-40 md:h-48 overflow-hidden">
    <img 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
      src={URLimagen} 
      alt={categoria} 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>
  <div class="p-4 text-center">
    <h3 class="text-base md:text-lg font-semibold text-gray-800 group-hover:text-[#ff8fa3] transition-colors duration-300">{categoria}</h3>
    <div class="w-8 h-0.5 bg-[#ffe4e9] mx-auto mt-3 group-hover:bg-[#ff8fa3] transition-colors duration-300 rounded-full"></div>
  </div>
</a>