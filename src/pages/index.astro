---

import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const openSeccion = {
  hero: true,
  nuestrosServicios: true,
  categorias: true,
  ubicacion: true,
  redes: true,
  academia: false,
  certificados: false,
};
---

<Layout>
	<Welcome 
		showAcademia={openSeccion.academia} 
		showCertificados={openSeccion.certificados} 
	/>
	{openSeccion.nuestrosServicios && <Header />}
</Layout>
