---
import Layout from '../layouts/Layout.astro';
import { getAcademia, getCursos, getAlumnas, getPromociones } from '../lib/Services/AcademiaServices';

const academia = getAcademia();
const cursos = getCursos();
const alumnos = getAlumnas();
const promociones = getPromociones();

const imagenesNails = [
  '/Imagenes/Nails/Acrilicas/acrilicas01.webp',
  '/Imagenes/Nails/Acrilicas/acrilicas02.webp',
  '/Imagenes/Nails/AcrilicasAlmendradas/AcrilicasAlmendradas01.webp',
  '/Imagenes/Nails/AcrilicasAlmendradas/AcrilicasAlmendradas02.webp',
  '/Imagenes/Nails/AcrilicasAlmendradas/AcrilicasAlmendradas03.webp',
  '/Imagenes/Nails/AcrilicasAlmendradas/AcrilicasAlmendradas04.webp',
  '/Imagenes/Nails/BanioAcrilico/banioAcrilico01.webp',
  '/Imagenes/Nails/BanioAcrilico/banioAcrilico02.webp',
  '/Imagenes/Nails/EsmalteEnGel/EsmalteEnGel01.webp',
  '/Imagenes/Nails/Acripie/acriPie01.webp',
  '/Imagenes/Nails/NaturalAcrilica/NaturalAcrilico.webp',
  '/Imagenes/Nails/Pedicura/Pedicura01.webp',
];

const imagenesAleatorias = imagenesNails.sort(() => Math.random() - 0.5).slice(0, 6);
---

<Layout>
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Academia</h1>
        <p class="text-gray-600 max-w-2xl mx-auto">Aprende el arte del nail art con profesionales</p>
      </div>
      
      <div class="max-w-3xl mx-auto text-center mb-16">
        <p class="text-gray-600 text-lg leading-relaxed mb-6">
          {academia.descripcion}
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          {academia.descripcion2}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-pink-50" id="cursos">
    <div class="container mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Cursos</h2>
      </div>
      
      <div class="max-w-lg mx-auto">
        {cursos.map((curso) => (
          <div class="flex justify-between items-center py-3 border-b border-gray-200">
            <span class="text-gray-800 font-medium">{curso.nombre}</span>
            <span class="text-[#ff8fa3] font-medium">{curso.horas} horas</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white" id="estudiantes">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">KeyNails Academia</h2>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {imagenesAleatorias.map((img) => (
          <div class="aspect-square rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
            <img class="w-full h-full object-cover" src={img} alt="Trabajo de nail art" />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>